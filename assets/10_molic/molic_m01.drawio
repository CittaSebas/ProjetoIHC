<mxfile host="app.diagrams.net"><diagram id="m01" name="M01"><mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1400" pageHeight="850" math="0" shadow="0"><root><mxCell id="0"/><mxCell id="1" parent="0"/><mxCell id="tit" value="&lt;b&gt;M01: Obter a trilha de estudo (O01)&lt;/b&gt;&lt;br&gt;Esboço. Autor: {{nome}}. Cenário CI01. Tarefa T01." style="text;html=1;align=left;verticalAlign=middle;fontSize=11;fontSize=13;" vertex="1" parent="1"><mxGeometry x="40" y="10" width="520" height="40" as="geometry"/></mxCell><mxCell id="A0" value="" style="ellipse;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="40" y="145" width="20" height="20" as="geometry"/></mxCell><mxCell id="S1" value="&lt;b&gt;Informar a questão&lt;/b&gt; (O02)&lt;hr&gt;d: cole o enunciado ou informe o identificador&lt;br&gt;u: [enunciado] ou [identificador]&lt;br&gt;&lt;i&gt;signos: enunciado, identificador da questão&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="110" y="80" width="260" height="150" as="geometry"/></mxCell><mxCell id="P1" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="445" y="140" width="28" height="28" as="geometry"/></mxCell><mxCell id="S2" value="&lt;b&gt;Examinar a trilha&lt;/b&gt; (O01, O03)&lt;hr&gt;d: tópicos e a ordem entre eles&lt;br&gt;d: por onde começar&lt;br&gt;d: a IA pode errar&lt;br&gt;d+u: esta trilha ajudou?&lt;br&gt;&lt;i&gt;signos: trilha de estudo, tópico, dependência entre tópicos, tópico inicial, aviso de erro da IA, avaliação da trilha&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="60" width="300" height="190" as="geometry"/></mxCell><mxCell id="P2" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="110" width="28" height="28" as="geometry"/></mxCell><mxCell id="E0" value="" style="ellipse;html=1;shape=endState;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="230" width="24" height="24" as="geometry"/></mxCell><mxCell id="S3" value="&lt;b&gt;Visualizar detalhes do tópico&lt;/b&gt; (O04, O05)&lt;hr&gt;d: explicação curta em português&lt;br&gt;d: Cormen, capítulo [n], ou sem capítulo específico&lt;br&gt;u: já estudei este tópico&lt;br&gt;&lt;i&gt;signos: explicação do tópico, livro-fonte, capítulo, marca de estudado&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="360" width="300" height="170" as="geometry"/></mxCell><mxCell id="P3" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="420" width="28" height="28" as="geometry"/></mxCell><mxCell id="S4" value="&lt;b&gt;Perguntar sobre o tópico&lt;/b&gt; (O06)&lt;hr&gt;u: [pergunta sobre o tópico]&lt;br&gt;d: [resposta com trechos do Cormen, sem resolver a questão]&lt;br&gt;&lt;i&gt;signos: pergunta sobre o tópico, resposta sobre o tópico&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=8;spacingTop=4;arcSize=8;fontSize=12;" vertex="1" parent="1"><mxGeometry x="560" y="640" width="300" height="140" as="geometry"/></mxCell><mxCell id="P4" value="" style="rounded=0;html=1;fillColor=#000000;strokeColor=#000000;" vertex="1" parent="1"><mxGeometry x="980" y="696" width="28" height="28" as="geometry"/></mxCell><mxCell id="U0" value="" style="ellipse;html=1;fillColor=#BFBFBF;strokeColor=#666666;" vertex="1" parent="1"><mxGeometry x="40" y="440" width="24" height="24" as="geometry"/></mxCell><mxCell id="S5" value="&lt;b&